---
import '../styles/global.css';
import { withLocalePath, type Locale } from '../i18n';
import FloatingNav from '../components/FloatingNav.astro';

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	locale?: Locale;
	copy: {
		nav: {
			projects: string;
			about: string;
			contact: string;
			cv: string;
		};
		footer: string;
	};
}

const {
	title = 'Portfolio',
	description = 'Backend engineer, distributed systems, and AI',
	keywords = 'Gabriel Rodríguez Delgado, Gabriel Esteban Rodriguez Delgado, Gabriel Rodriguez, Gabriel rd, Gabriel.rd, backend engineer, distributed systems, AI, portfolio, software engineering',
	locale = 'en',
	copy,
} = Astro.props;
const currentYear = new Date().getFullYear();
const siteUrl = Astro.site ?? '';
const basePath = withLocalePath('/', locale);
const pathWithoutLocale = Astro.url.pathname.replace(/^\/(es|it)(?=\/|$)/, '') || '/';
const enPath = withLocalePath(pathWithoutLocale, 'en');
const esPath = withLocalePath(pathWithoutLocale, 'es');
const itPath = withLocalePath(pathWithoutLocale, 'it');
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/icon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<title>{title}</title>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{siteUrl && <meta property="og:url" content={siteUrl} />}
		<meta property="og:site_name" content="Gabriel.rd | Portfolio" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{siteUrl && <link rel="canonical" href={siteUrl} />}
		<style is:global>
			html { color-scheme: dark; }

			/* ── Top nav: floating-mode transition ── */
			#topnav {
				transition: transform 380ms cubic-bezier(0.4, 0, 0.2, 1), opacity 300ms ease;
			}
			body.nav-floating #topnav {
				transform: translateY(-100%);
				opacity: 0;
				pointer-events: none;
			}
			/* No transition on initial load to prevent flash */
			body.nav-floating-init #topnav,
			body.nav-floating-init #sao-nav {
				transition: none !important;
			}

			/* ── Convert button spin animation ── */
			.nav-to-float-btn.converting {
				animation: nav-btn-spin 500ms ease forwards;
			}
			@keyframes nav-btn-spin {
				0%   { transform: rotate(0deg)    scale(1);    }
				35%  { transform: rotate(-160deg) scale(0.82); }
				70%  { transform: rotate(-340deg) scale(0.92); }
				100% { transform: rotate(-360deg) scale(1);    }
			}
		</style>
	</head>
	<body class="bg-dark-bg text-text-primary font-sans antialiased">

		<!-- Top navbar -->
		<nav id="topnav" class="fixed top-0 w-full z-50 bg-dark-bg/80 backdrop-blur-sm border-b border-border">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
				<a href={basePath} class="text-lg font-bold hover:text-accent transition-colors" aria-label="Home">
					&lt; /web &gt;
				</a>

				<!-- Mobile links -->
				<div class="flex gap-2 text-xs font-mono sm:hidden items-center">
					<a href="/cv" class="min-h-10 px-3 py-2 rounded border inline-flex items-center justify-center text-text-secondary border-border hover:text-accent hover:border-accent/50 transition-colors">{copy.nav.cv}</a>
					<a href={enPath} aria-label="Switch to English" class={`min-h-10 min-w-10 px-3 py-2 rounded border inline-flex items-center justify-center ${locale === 'en' ? 'text-accent border-accent/50' : 'text-text-secondary border-border'}`}>EN</a>
					<a href={esPath} aria-label="Cambiar a español" class={`min-h-10 min-w-10 px-3 py-2 rounded border inline-flex items-center justify-center ${locale === 'es' ? 'text-accent border-accent/50' : 'text-text-secondary border-border'}`}>ES</a>
					<a href={itPath} aria-label="Passa all'italiano" class={`min-h-10 min-w-10 px-3 py-2 rounded border inline-flex items-center justify-center ${locale === 'it' ? 'text-accent border-accent/50' : 'text-text-secondary border-border'}`}>IT</a>
					<!-- Convert to floating -->
					<button
						class="nav-to-float-btn min-h-10 min-w-10 px-2 rounded border inline-flex items-center justify-center text-text-secondary border-border hover:text-accent hover:border-accent/50 transition-colors"
						aria-label="Switch to floating navigation"
						title="Switch to floating navigation"
					>
						<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 4.5l-15 15m0 0h11.25m-11.25 0V8.25" />
						</svg>
					</button>
				</div>

				<!-- Desktop links -->
				<div class="hidden sm:flex gap-6 text-sm items-center">
					<a href={`${basePath}#projects`} class="hover:text-accent transition-colors">{copy.nav.projects}</a>
					<a href={`${basePath}#about`} class="hover:text-accent transition-colors">{copy.nav.about}</a>
					<a href={`${basePath}#contact`} class="hover:text-accent transition-colors">{copy.nav.contact}</a>
					<a href="/cv" class="hover:text-accent transition-colors">{copy.nav.cv}</a>
					<div class="flex gap-2 ml-2 text-xs font-mono">
						<a href={enPath} class={locale === 'en' ? 'text-accent' : 'text-text-secondary'}>EN</a>
						<a href={esPath} class={locale === 'es' ? 'text-accent' : 'text-text-secondary'}>ES</a>
						<a href={itPath} class={locale === 'it' ? 'text-accent' : 'text-text-secondary'}>IT</a>
					</div>
					<!-- Convert to floating -->
					<button
						class="nav-to-float-btn w-8 h-8 ml-1 rounded border inline-flex items-center justify-center text-text-secondary border-border hover:text-accent hover:border-accent/50 transition-colors"
						aria-label="Switch to floating navigation"
						title="Switch to floating navigation"
					>
						<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 4.5l-15 15m0 0h11.25m-11.25 0V8.25" />
						</svg>
					</button>
				</div>
			</div>
		</nav>

		<!-- SAO-style floating nav -->
		<FloatingNav
			nav={copy.nav}
			basePath={basePath}
			locale={locale}
			enPath={enPath}
			esPath={esPath}
			itPath={itPath}
		/>

		<!-- Main content -->
		<main class="pt-16">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="py-12 border-t border-border mt-20 bg-dark-bg">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
				<p class="text-text-secondary text-sm text-center">© {currentYear} · {copy.footer}</p>
			</div>
		</footer>
	</body>
</html>

<style>
	body {
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
	}
</style>
