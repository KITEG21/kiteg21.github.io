---
import Layout from '../layouts/Layout.astro';
import CVContent from '../components/CVContent.astro';
import { copy } from '../i18n';
import { getCvCopy } from '../data/cvTranslations';

const t = copy.en;
const cv = getCvCopy('en');
---

<Layout
	title="Gabriel.rd | CV"
	description="CV and technical profile of Gabriel Rodriguez — Backend Software Engineer, Tech Lead, Co-Founder."
	locale="en"
	copy={t}
>
	<CVContent cv={cv} />
</Layout>
